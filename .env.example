# Скопировать в .env и заполнить своими значениями:
# cp .env.example .env

# PostgreSQL
# Сервис ожидает внешний PostgreSQL/TimescaleDB.
# Для запуска приложения на хосте обычно localhost, из Docker Desktop — host.docker.internal.
POSTGRES_DSN=postgres://user:password@host.docker.internal:5432/analysis?sslmode=disable

# gRPC сервер
# Если не задан HOST — используется 0.0.0.0
GRPC_HOST=0.0.0.0
# Если не задан PORT — используется 50051
GRPC_PORT=50051

# Отключить TLS (только для локальной разработки / docker compose без mTLS)
# Если true — сертификаты не нужны, сервис стартует без TLS credentials
GRPC_TLS_DISABLE=true

# mTLS — пути к файлам сертификатов для production-запуска
#GRPC_TLS_CERT_FILE=/run/certs/cert.pem
#GRPC_TLS_KEY_FILE=/run/certs/key.pem
#GRPC_TLS_CA_FILE=/run/certs/ca.pem

# Уникальный идентификатор сервиса (UUID)
# Если не задан — генерируется автоматически при каждом запуске
# Генерация: uuidgen
SERVICE_ID=

# Имя сервиса для health-check и трейсинга
# Если не задано — генерируется автоматически: analysis_<serviceID>
SERVICE_NAME=Analysis

# Логирование
# Уровень: debug | info | warn | error
LOG_LEVEL=info
# Формат: json | console
# json — продакшн, console — локальная разработка
LOG_FORMAT=console
