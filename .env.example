# Скопировать в .env и заполнить своими значениями:
# cp .env.example .env

# PostgreSQL
# Формат: postgres://user:password@host:port/dbname?sslmode=disable
POSTGRES_DSN=postgres://user:password@localhost:5432/analysis?sslmode=disable

# Директория для хранения результатов прогонов
# Если не задана — используется ./data/runs
RUNS_STORAGE_DIR=/data/runs

# gRPC сервер
# Если не задан HOST — используется 0.0.0.0
GRPC_HOST=0.0.0.0
# Если не задан PORT — используется 50051
# Порт должен совпадать с ports: в docker-compose.yml
GRPC_PORT=50051

# Секретный токен для межсервисной аутентификации
# Обязательный — сервис не стартует без него
# Генерация: openssl rand -hex 32
# В prod передавать через Docker secret или системный env, не через .env
SERVICE_SECRET_TOKEN=

# Имя сервиса для health-check и трейсинга
# Если не задано — генерируется автоматически: analysis_<uuid>
SERVICE_NAME=analysis

# Логирование
# Уровень: debug | info | warn | error
LOG_LEVEL=info
# Формат: json | console
# json — продакшн, console — локальная разработка
LOG_FORMAT=console